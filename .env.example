# =============================================================================
# ELPIS — Variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et ajustez les valeurs selon votre environnement.
# NE JAMAIS commiter le fichier .env (il est dans .gitignore).
# =============================================================================

# --- Serveur Bridge ---
PORT=3001                            # Port du serveur Express (défaut: 3001)
LOG_LEVEL=info                       # debug | info | warn | error

# --- Sécurité ---
ADMIN_PASSWORD=                      # Laissez vide pour désactiver l'auth basic
# ADMIN_PASSWORD=monMotDePasseAdmin  # Active la protection par mot de passe

# --- DeepSeek AI (pour /api/chat et l'orchestrateur) ---
DEEPSEEK_API_KEY=                    # Votre clé API DeepSeek (obligatoire pour l'IA)
DEEPSEEK_MODEL=deepseek-chat         # Modèle utilisé (défaut: deepseek-chat)

# --- Base de données ---
# DB_PATH est défini automatiquement dans db/setup.js -> data/elpis.sqlite
# Vous pouvez le surcharger ici si nécessaire :
# DB_PATH=/chemin/vers/elpis.sqlite

# --- Python (pour l'agent d'audit) ---
PYTHON_PATH=python                   # ou python3 selon votre système
